def rotarDerechita(matrizita):
    filitas = len(matrizita)
    columnitas = len(matrizita[0])

    listita = []
    for filita in range(filitas):
        for columnita in range(columnitas):
            listita.append(matrizita[filita][columnita])

    ultimito = listita[len(listita) - 1]
    for i in range(len(listita) - 1, 0, -1):
        listita[i] = listita[i - 1]
    listita[0] = ultimito

    contadorcito = 0
    for filita in range(filitas):
        for columnita in range(columnitas):
            matrizita[filita][columnita] = listita[contadorcito]
            contadorcito += 1

def mostrarMatrizita(matriz):
    for filita in matriz:
        print(filita)

