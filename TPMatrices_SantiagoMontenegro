def productoMatrizitas(matri1, matri2):
    filitasA = len(matri1)
    columitasA = len(matri1[0])
    filitasB = len(matri2)
    columitasB = len(matri2[0])
    
    
    if columitasA != filitasB:
        print("No se pueden multiplicar")
        return None
    
    
    matrizProd = []
    for i in range(filitasA):
        filitaNueva = []
        for j in range(columitasB):
            filitaNueva.append(0.0)
        matrizProd.append(filitaNueva)
    
   
    for i in range(filitasA):
        for j in range(columitasB):
            suma = 0.0
            for k in range(columitasA):
                suma += matri1[i][k] * matri2[k][j]
            matrizProd[i][j] = suma
    
    return matrizProd

